{
  "name": "presupuestos-front",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest",
    "build": "next build",
    "verify:suite": "node scripts/verify-suite.mjs",
    "verify:tests-untouched": "git diff --exit-code -- '**/*.test.ts' '**/*.test.tsx' 'tests/' 'scripts/verify-suite.mjs' && test -z \"$(git status --porcelain -- '**/*.test.ts' '**/*.test.tsx' 'tests/' 'scripts/')\"",
    "verify:tests": "pnpm run verify:tests-untouched"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.101.4",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
